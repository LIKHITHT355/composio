# LLM Configuration
# Options: gemini | openai | anthropic | groq | huggingface | deepseek | openrouter | together | xai
LLM_PROVIDER=gemini
FAST_MODEL=gemini-2.5-flash
STRONG_MODEL=gemini-2.5-pro

# Primary Providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# High-Rate-Limit & Ultra-Cheap Alternatives
GROQ_API_KEY=                   # Ultra-fast inference (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant)
HUGGINGFACE_API_KEY=            # Hugging Face Inference API / Serverless Router
DEEPSEEK_API_KEY=               # DeepSeek API (deepseek-chat / deepseek-reasoner)
OPENROUTER_API_KEY=             # Unified gateway to hundreds of cheap/free models
TOGETHER_API_KEY=               # High throughput open source models
XAI_API_KEY=                    # Grok (e.g. grok-beta)

# Composio Integration
COMPOSIO_API_KEY=

# Search Providers
SERPAPI_API_KEY=
TAVILY_API_KEY=

# Budget & Limits
MAX_BUDGET_USD=20.0
CACHE_DIR=data/cache
