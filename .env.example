# ==============================================================================
# SECTION 1: PRIMARY KEYS (ACTIVE / REQUIRED)
# ==============================================================================

# LLM Runtime Settings
LLM_PROVIDER=gemini
FAST_MODEL=gemini-3.5-flash-lite
STRONG_MODEL=gemini-2.5-pro

# 1. Google Gemini (15 RPM / 1,500 req/day free): https://aistudio.google.com
GEMINI_API_KEY=

# 2. OpenAI: https://platform.openai.com
OPENAI_API_KEY=

# 3. Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=

# 4. Composio Integration: https://composio.dev
COMPOSIO_API_KEY=

# 5. Serper.dev (2,500 free Google searches, NO CC): https://serper.dev
SERPER_API_KEY=

# 6. Firecrawl (500 free clean markdown scrapes & JS renders, NO CC): https://firecrawl.dev
FIRECRAWL_API_KEY=

# 7. SerpAPI (100 free searches/month): https://serpapi.com
SERPAPI_API_KEY=

# Budget & Storage
MAX_BUDGET_USD=20.0
CACHE_DIR=data/cache


# ==============================================================================
# SECTION 2: OPTIONAL ALTERNATIVES (NO KEYS YET - NO CREDIT CARD NEEDED)
# ==============================================================================

